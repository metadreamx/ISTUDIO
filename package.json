{
  "name": "istudio",
  "private": true,
  "version": "1.0.17",
  "description": "Reference-based photo editing by Iconic Recordings.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "start": "node dist-server/server.js",
    "lint": "tsc --noEmit",
    "test:gemini": "node scripts/gemini-parity-check.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "chokidar": "^4.0.3",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "onnxruntime-node": "^1.26.0",
    "postprocessing": "^6.39.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-zoom-pan-pinch": "^3.6.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "three": "^0.184.0",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.9",
    "tsx": "^4.21.0",
    "xatlas-web": "^0.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.27.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
